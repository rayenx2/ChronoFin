# FinanceFlow-AI — Environment Variables
# Copy this file to .env and fill in the values

# ── Alpha Vantage (free API key at https://www.alphavantage.co/support/#api-key) ──
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://airflow:airflow@localhost:5432/stockai

# ── Redis ─────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── MinIO (local S3-compatible data lake) ─────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── MLflow ────────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Model paths ───────────────────────────────────────────────────────────────────
MODEL_DIR=./models
PROCESSED_PATH=./data/processed

# ── Apache Airflow ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__SECRET_KEY=changeme_in_production
